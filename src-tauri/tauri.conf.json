{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KamiPanda",
  "version": "1.6.0",
  "identifier": "com.giathanh.kamipanda",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KamiPanda",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCM0RBNkM1QkIwNTQwRTQKUldUa1FBVzd4YVk5bTBvcTNCc1R0S08rcnJRTkVka0dNdHN1SlhGcjhIVTJNaVBSZ2xmRis1UTQK",
      "endpoints": [
        "https://github.com/giathanh/KamiPanda/releases/latest/download/latest.json"
      ]
    }
  }
}
